# Необязательный файл: docker compose подхватывает его сам для подстановки
# переменных, а без него используются значения по умолчанию из compose.
# Нужен при локальном запуске без Docker. Скопировать:  cp .env.example .env

GALS_ENV=dev
GALS_DEBUG=true
GALS_LOG_LEVEL=INFO

# --- база данных -------------------------------------------------------------
POSTGRES_USER=gals
POSTGRES_PASSWORD=gals
POSTGRES_DB=gals
GALS_DATABASE_URL=postgresql+psycopg://gals:gals@db:5432/gals
GALS_DATABASE_POOL_SIZE=5
GALS_DATABASE_MAX_OVERFLOW=10
GALS_DATABASE_ECHO_SQL=false

# --- очередь -----------------------------------------------------------------
GALS_REDIS_URL=redis://redis:6379/0
GALS_CELERY_BROKER_URL=redis://redis:6379/0
GALS_CELERY_QUEUE=gals
# true — выполнять фоновые задачи прямо в вызывающем потоке, без Redis.
# В compose всегда false: иначе получасовой расчет исполнится внутри
# HTTP-запроса. Значение для тестов ставит сам pytest (tests/conftest.py).
GALS_CELERY_TASK_ALWAYS_EAGER=false
# Сколько расчетов воркер ведет одновременно.
WORKER_CONCURRENCY=2

# --- HTTP --------------------------------------------------------------------
# Пусто: фронтенд и API ходят через один origin (nginx / dev-proxy Vite).
GALS_CORS_ORIGINS=[]
GALS_MAX_UPLOAD_BYTES=52428800

# --- расчет ------------------------------------------------------------------
# Сколько секунд POST /api/plans ждет результата, прежде чем отдать 202 и job.
# В проде — 0 (фронт всегда опрашивает статус).
GALS_PLAN_SYNC_WAIT_SECONDS=30
GALS_PLAN_TIME_LIMIT_S=1800
GALS_PLAN_HARD_TIME_LIMIT_S=1980
GALS_MAX_AUTO_RECALC=3
GALS_CANCEL_GRACE_SECONDS=30
GALS_JOB_HEARTBEAT_SECONDS=15
GALS_JOB_STALE_AFTER_SECONDS=120

# --- параметры математической модели ------------------------------------------
GALS_ENERGY_RESERVE=0.20
GALS_MANEUVER_MARGIN=0.0
GALS_COVERAGE_TOLERANCE=0.01
GALS_SEPARATION_DISTANCE_M=100
GALS_SEPARATION_TIME_S=30
GALS_SEPARATION_HEIGHT_M=20
GALS_DISCRETIZE_STEP_S=5

# --- экспорт -----------------------------------------------------------------
GALS_EXPORT_DIR=/data/exports
GALS_EXPORT_RETENTION_DAYS=30

# --- тесты (не используются контейнерами) --------------------------------------
# Если задано — pytest подключается сюда вместо поднятия testcontainers.
# База обязана быть ОТДЕЛЬНОЙ от рабочей: изоляция теста — откат транзакции,
# и он не уберет данные, которые в базу положило работающее приложение.
# Создать один раз:
#   docker compose exec db psql -U gals -d postgres -c 'CREATE DATABASE gals_test OWNER gals;'
# GALS_TEST_DATABASE_URL=postgresql+psycopg://gals:gals@127.0.0.1:55432/gals_test

# На Apple Silicon: нативный arm64-образ PostGIS вместо эмуляции amd64.
# POSTGIS_IMAGE=imresamu/postgis:16-3.4

# Порты на хосте (dev-надстройка), если стандартные заняты другими проектами.
# API_PORT=8000
# DB_PORT=55432
